      "team_plan",
      "team_conference"
    ],
    "maxReviewsPerMember": 400,
    "maxReviewsPerTask": 2000,
    "maxConsecutiveGateErrors": 5,
    "gateErrorCooldownMs": 60000,
    "uncontrolledTools": [
      "read",
      "read_image",
      "glob",
      "grep",
      "todo_write",
      "list_agents",
      "send_message",
      "interrupt_agent",
      "team_models",
      "team_concurrency",
      "team_status",
      "team_discuss",
      "team_plan_archive",
      "job_list",
      "job_output",
      "team_tools",
      "team_skills"
    ],
    "pathArgs": {
      "write": [
        "file_path"
      ],
      "edit": [
        "file_path"
      ],
      "team_note": [
        "path"
      ]
    },
    "shellTools": [
      "pwsh",
      "bash"
    ],
    "mutatingTools": [
      "write",
      "edit",
      "pwsh",
      "bash",
      "job_kill"
    ],
    "requireReadBeforeWrite": true,
    "maxArgChars": 12000,
    "maxAuthorizationChars": 6000
